<div id="main" class="border border-white w-full h-content text-black" >
    <div id="top-cont" class="border border-white flex justify-center items-center gap-16 mx-24 mt-12 cont-60 art-station-bg">
        <div id="image-cont" class="border border-black image-cont">
            <img src={@movie.poster_path} alt={@movie.title} class="img rounded-lg shadow-lg"/>
        </div>
        <div id="text-cont" class="border border-red-500 flex-col justify-between image-cont w-50 text-white">
            <div>
                <h1 class="text-4xl font-blacknorth font-bold mb-5"><%= @movie.title %></h1>
                <p class="mb-4 text-xl"> <%= @movie.description %> </p>
                <p class="mb-2"><strong>Duration:</strong> <%= @movie.duration %></p>
                <p class="mb-2"><strong>Genre:</strong> <%= @movie.genre %></p>
                <p class="mb-2"><strong>Year:</strong> <%= @movie.year %></p>
                <p class="mb-4"><strong>Rating:</strong> <%= @movie.ratings %></p>    
            </div>
            <div id="buttons" class="flex gap-4">
                <button phx-click="show_trailer" class="bg-red-600 text-white py-2 px-4 rounded-lg hover:bg-red-700 transition duration-300">
                  Watch Trailer
                </button>
                <.link navigate={~p"/play/#{@movie.id}"} class="flex items-center gap-2 rounded-lg bg-red-500 py-2 px-4 text-black">
                  <img src={~p"/images/play.png"} width="24"/>
                  Watch now
                </.link>
            </div>
        </div>
    </div>

    <div id="cast-cont" class="border border-white h-80">
        cast-cont
        <p> Cast </p>
        <div id="cast">

        </div>
    </div>

</div>







